+			}),
+		),
+		stdout: "pipe",
+		stderr: "pipe",
+	});
+	const [output, errors, code] = await Promise.all([
+		new Response(proc.stdout).arrayBuffer(),
+		new Response(proc.stderr).arrayBuffer(),
+		proc.exited,
+	]);
+	expect(code).toBe(1);
+	expect(output.byteLength + errors.byteLength).toBeLessThanOrEqual(512 * 1024);
+	expect(output.byteLength).toBeGreaterThan(0);
+	expect(errors.byteLength).toBeGreaterThan(0);
+});
diff --git a/packages/agent-setup/src/claude-usage-statusline.ts b/packages/agent-setup/src/claude-usage-statusline.ts
